{% extends 'base.html.twig' %}

{% block title %}Hello RateController!{% endblock %}

{% block body %}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>note</title>
    <style>
        .star {
            font-size: 1.5rem;
        }
        
        .hover {
            color: rgb(255, 196, 0);
        }
    </style>
</head>

<body>
    <h1 style="color: brown;">donner note</h1>
    <i class="star"  style="font-size: 36px;" data-note="1">&#9733;</i>
    <i class="star" style="font-size: 36px;" data-note="2">&#9733;</i>
    <i class="star" style="font-size: 36px;" data-note="3">&#9733;</i>
    <i class="star" style="font-size: 36px;" data-note="4">&#9733;</i>
    <i class="star" style="font-size: 36px;" data-note="5">&#9733;</i>
    <i class="note">Note:    
</i>
    {% set id1 =  id  %} 

    <script>
    const id1 = {{ id|json_encode|raw }};
        const stars = document.querySelectorAll('.star');
        let check = false;
        stars.forEach(star => {
            star.addEventListener('mouseover', selectStars);
            star.addEventListener('mouseleave', unselectStars);
            star.addEventListener('click', activeSelect);
        })

        function selectStars(e) {
            const data = e.target;
            const etoiles = priviousSiblings(data);
            if (!check) {
                etoiles.forEach(etoile => {
                    etoile.classList.add('hover');
                })
            }

        }

        function unselectStars(e) {
            const data = e.target;
            const etoiles = priviousSiblings(data);
            if (!check) {
                etoiles.forEach(etoile => {
                    etoile.classList.remove('hover');
                })
            }
            
        }

        function activeSelect(e) {
            if (!check) {
                check = true;
                document.querySelector('.note').innerHTML = 'Note ' + e.target.dataset.note;
                const rating = e.target.dataset.note;
                sendData(rating);
            }
            if (check){
                 check = false;
            }

        }

        function priviousSiblings(data) {
            let values = [data];
            while (data = data.previousSibling) {
                if (data.nodeName === 'I') {
                    values.push(data);
                }
            }
            return values;
        }
        function sendData(rating) {
  const xhr = new XMLHttpRequest();
  xhr.open('POST',"{{ path('app_note', { 'id': id1 }) }}", true); // modify the URL to your Symfony controller
  xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
  xhr.onreadystatechange = function() {
    if (this.readyState === XMLHttpRequest.DONE && this.status === 200) {
      console.log('Data sent successfully');
    } else if (this.readyState === XMLHttpRequest.DONE && this.status !== 200) {
      console.error('Error sending data');
    }
  };
  xhr.send('rating=' + rating); // send the rating data as a POST parameter
}
function sendId(id1) {
  const xhr = new XMLHttpRequest();
  xhr.open('POST', "{{ path('app_note', { 'id': id1 }) }}" , true); // modify the URL to your Symfony controller
  xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
  xhr.send('id=' + id1); // no data needs to be sent

  xhr.onreadystatechange = function() {
    if (this.readyState === XMLHttpRequest.DONE && this.status === 200) {
      console.log('ID sent successfully');
    } else if (this.readyState === XMLHttpRequest.DONE && this.status !== 200) {
      console.error('Error sending ID');
    }
  };
}
    </script>
    {# replace with your own id value #}


</body>

</html>

{% endblock %}
